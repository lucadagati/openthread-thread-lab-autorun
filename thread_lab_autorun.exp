#!/usr/bin/expect -f

# Thread lab autorun (OpenThread CLI + commissioning + ot-daemon/ot-ctl)
#
# How it works:
# - Uses Docker container `codelab_otsim_ctnr` (default) running in background.
# - Spawns interactive CLI sessions via `docker exec -it` and controls them with expect.
# - Parses outputs to extract Network Key / PAN ID / EID / RLOC16 / RCP eui64.
# - Verifies checkpoint keywords and ping results.
#
# Limitations:
# - This is tuned for the commands shown in the provided deck.

set timeout 30
set user_spawn_id ""

proc log {msg} {
  puts "THREAD-LAB: $msg"
  flush stdout
}

proc fail {msg} {
  puts stderr "THREAD-LAB-FAIL: $msg"
  exit 1
}

# Wait for a prompt matching `re` in a given spawn_id.
proc wait_prompt_re {sid re} {
  expect -i $sid -re $re
}

proc send_cmd_wait_prompt {sid cmd {prompt_re {>\s*$}}} {
  # Send command and wait until the CLI prompt is back.
  puts "THREAD-LAB: (sid=$sid) >> $cmd"
  send -i $sid -- "$cmd\r"
  expect -i $sid -re $prompt_re
}

proc send_cmd_and_expect {sid cmd expect_re prompt_re} {
  # Send command and wait for a target string somewhere before prompt.
  puts "THREAD-LAB: (sid=$sid) >> $cmd"
  send -i $sid -- "$cmd\r"
  expect -i $sid -re $expect_re
  expect -i $sid -re $prompt_re
}

proc spawn_docker_exec_cli {sid_name container cmd} {
  # Spawn a docker exec interactive CLI and return spawn_id.
  log "Spawning ${sid_name}: $cmd"
  spawn docker exec -it $container bash -lc $cmd
  set sid $spawn_id
  return $sid
}

proc spawn_docker_exec_bg {container bash_cmd} {
  # Run a long-running command inside container in the background (detached).
  # Uses docker exec without TTY.
  log "Running background command: $bash_cmd"
  exec docker exec -d $container bash -lc $bash_cmd >/dev/null 2>&1
}

proc docker_exec_capture {container bash_cmd} {
  # Run non-interactive command and capture stdout.
  set out [exec docker exec $container bash -lc $bash_cmd]
  return $out
}

proc ensure_container {container image} {
  # Pull image
  log "Pulling Docker image: $image"
  # Stream pull progress to the console (avoid silent hang).
  global timeout
  set old_timeout $timeout
  set timeout 600
  spawn docker pull $image
  expect eof
  set timeout $old_timeout

  # Always recreate the container to avoid stale CLI state across runs.
  set exists 0
  if {[catch {exec docker inspect $container >/dev/null 2>&1}]} {
    set exists 0
  } else {
    set exists 1
  }

  if {$exists == 1} {
    log "Recreating container: $container"
    catch {exec docker rm -f $container >/dev/null 2>&1}
  }

  log "Starting container: $container"
  # Keep container alive using a sleep loop.
  exec docker run -d --name $container \
    --sysctl net.ipv6.conf.all.disable_ipv6=0 \
    --cap-add=net_admin \
    $image bash -lc "while true; do sleep 3600; done" >/dev/null

  # Wait briefly for the container to become "running" before issuing docker exec.
  # Docker Desktop sometimes reports State.Running asynchronously after start.
  set ready 0
  for {set i 0} {$i < 120} {incr i} {
    if {[catch {exec docker inspect -f "{{.State.Running}}" $container} running_now]} {
      set running_now ""
    }
    if {$running_now eq "true"} {
      set ready 1
      break
    }
    after 500
  }
  if {!$ready} {
    fail "Container did not reach running state: $container"
  }
}

proc extract_dataset_key_panid {sid} {
  # Backward-compatible wrapper kept for existing call sites.
  set network_key [capture_dataset_networkkey $sid]
  set pan_id [capture_dataset_panid $sid]
  return [list $network_key $pan_id]
}

proc capture_ipaddr_eid {sid} {
  # Deterministic EID capture using mleid command.
  puts "THREAD-LAB: (sid=$sid) capturing EID via ipaddr mleid"
  send -i $sid -- "ipaddr mleid\r"
  expect -i $sid -re {(fd[0-9a-fA-F:]+)}
  set eid $expect_out(1,string)
  expect -i $sid -re {>\s*$}
  if {$eid eq ""} {
    fail "Could not determine EID via ipaddr mleid"
  }
  return $eid
}

proc capture_dataset_networkkey {sid} {
  send -i $sid -- "dataset networkkey\r"
  expect -i $sid -re {([0-9a-fA-F]{32})}
  set network_key $expect_out(1,string)
  expect -i $sid -re {>\s*$}
  return $network_key
}

proc capture_dataset_panid {sid} {
  send -i $sid -- "dataset panid\r"
  expect -i $sid -re {0x([0-9a-fA-F]{4})}
  set pan_id $expect_out(1,string)
  expect -i $sid -re {>\s*$}
  return $pan_id
}

proc verify_state_exact {sid expected} {
  send -i $sid -- "state\r"
  expect -i $sid -re $expected
  expect -i $sid -re {>\s*$}
}

proc extract_rloc16 {sid} {
  send -i $sid -- "rloc16\r"
  # Capture the 16-bit RLOC line value (4 hex chars).
  expect -i $sid -re {([0-9a-fA-F]{4})\r?\n}
  set rloc16 $expect_out(1,string)
  expect -i $sid -re {>\s*$}
  return $rloc16
}

proc verify_router_table_contains {sid_router_table sid_with_rloc rloc16} {
  # Runs `router table` on Node1 and checks `0x$rloc16` appears.
  send -i $sid_router_table -- "router table\r"
  expect -i $sid_router_table -re "0x$rloc16"
  expect -i $sid_router_table -re {>\s*$}
}

proc ping_and_verify {sid_ping eid} {
  # Sends ping once (as in deck) and expects 'bytes from <eid>'
  send -i $sid_ping -- "ping $eid\r"
  # Match one reply line.
  expect -i $sid_ping -re "bytes from $eid"
  # After reply, prompt should come back; to be safe, wait for it.
  expect -i $sid_ping -re {>\s*$}
}

proc stop_and_factoryreset {sid} {
  send_cmd_wait_prompt $sid "thread stop" {>\s*$}
  send_cmd_wait_prompt $sid "factoryreset" {>\s*$}
}

proc start_commissioner_and_allow_wildcard {sid} {
  send_cmd_wait_prompt $sid "commissioner start" {>\s*$}
  send_cmd_wait_prompt $sid "commissioner joiner add * J01NME" {>\s*$}
}

proc start_joiner {sid} {
  send_cmd_wait_prompt $sid "joiner start J01NME" {>\s*$}
  # deck expects Join success message
  # We'll re-run joiner start with expect for Join success if needed (covered separately)
}

proc joiner_start_wait_success {sid} {
  puts "THREAD-LAB: (sid=$sid) >> joiner start J01NME"
  send -i $sid -- "joiner start J01NME\r"
  expect -i $sid -re {Join success}
  expect -i $sid -re {>\s*$}
}

proc otctl_eui64 {sid} {
  send -i $sid -- "eui64\r"
  expect -i $sid -re {([0-9a-fA-F]{2,})\r?\n}
  set eui64 $expect_out(1,string)
  expect -i $sid -re {>\s*$}
  return $eui64
}

proc wait_rcp_state {sid {max_sec 120}} {
  # Wait until ot-ctl reports a stable state and return it.
  set start_time [clock seconds]
  while {[expr {[clock seconds]-$start_time}] < $max_sec} {
    send -i $sid -- "state\r"
    expect -i $sid -re {router|child|detached|disabled}
    set st $expect_out(0,string)
    expect -i $sid -re {>\s*}
    if {$st eq "router" || $st eq "child"} {
      return $st
    }
    after 3000
  }
  return "detached"
}

proc otctl_join_restricted_and_start_thread {sid_otctl joiner_eui64 eid} {
  # This proc is used after Node1 already configured.
  # ot-ctl flow:
  send_cmd_wait_prompt $sid_otctl "ifconfig up" {>\s*$}
  # joiner start
  puts "THREAD-LAB: (sid=$sid_otctl) >> joiner start J01NME"
  send -i $sid_otctl -- "joiner start J01NME\r"
  expect -i $sid_otctl -re {Join success}
  expect -i $sid_otctl -re {>\s*$}
  send_cmd_wait_prompt $sid_otctl "thread start" {>\s*$}
  # Validate state router
  send -i $sid_otctl -- "state\r"
  expect -i $sid_otctl -re {router}
  expect -i $sid_otctl -re {>\s*$}
}

proc make_tun {container} {
  # Create TUN if needed; ignore errors.
  log "Ensuring /dev/net/tun exists"
  catch {
    exec docker exec $container bash -lc "mkdir -p /dev/net && (mknod /dev/net/tun c 10 200 || true) && chmod 600 /dev/net/tun"
  }
}

set container [lindex $argv 0]
set image [lindex $argv 1]

log "Starting autorun"
ensure_container $container $image

# --- Exercise 1: simulate 2 nodes ---
log "Exercise 1: simulate a Thread network (Node1 + Node2)"

set cli1_cmd "/openthread/build/examples/apps/cli/ot-cli-ftd 1"
set cli2_cmd "/openthread/build/examples/apps/cli/ot-cli-ftd 2"

# Start Node 1 CLI
spawn docker exec -it $container bash -lc "$cli1_cmd"
set sid1 $spawn_id
wait_prompt_re $sid1 {>\s*$}

send_cmd_wait_prompt $sid1 "dataset init new" {>\s*$}
set network_key [capture_dataset_networkkey $sid1]
set pan_id [capture_dataset_panid $sid1]

send_cmd_wait_prompt $sid1 "dataset commit active" {>\s*$}
send_cmd_wait_prompt $sid1 "ifconfig up" {>\s*$}
send_cmd_wait_prompt $sid1 "thread start" {>\s*$}

# Wait for leader
send -i $sid1 -- "state\r"
expect -i $sid1 -re {leader}
expect -i $sid1 -re {>\s*$}
log "Node1 is leader"

set node1_eid [capture_ipaddr_eid $sid1]
log "Node1 EID captured: $node1_eid"

# Start Node 2 CLI
spawn docker exec -it $container bash -lc "$cli2_cmd"
set sid2 $spawn_id
wait_prompt_re $sid2 {>\s*$}

send_cmd_wait_prompt $sid2 "dataset networkkey $network_key" {>\s*$}
send_cmd_wait_prompt $sid2 "dataset panid 0x$pan_id" {>\s*$}
send_cmd_wait_prompt $sid2 "dataset commit active" {>\s*$}
send_cmd_wait_prompt $sid2 "ifconfig up" {>\s*$}
send_cmd_wait_prompt $sid2 "thread start" {>\s*$}

# Wait for Node2 to become router (poll)
set start_time [clock seconds]
set router_ok 0
while {[expr {[clock seconds]-$start_time}] < 130} {
  send -i $sid2 -- "state\r"
  expect -i $sid2 -re {router|child}
  set st $expect_out(0,string)
  expect -i $sid2 -re {>\s*$}
  if {$st eq "router"} { set router_ok 1; break }
  after 5000
}
if {!$router_ok} { fail "Node2 did not reach router state in time" }
log "Node2 is router"

# Verify connectivity via router table + RLOC16
set rloc16 [extract_rloc16 $sid2]
log "Node2 RLOC16: $rloc16"

verify_router_table_contains $sid1 $sid2 $rloc16
log "Router table contains Node2 RLOC16"

# Ping Node1 EID from Node2
ping_and_verify $sid2 $node1_eid
log "Ping Node2->Node1 succeeded"

# Failover: stop Node1 thread and wait Node2 leader
send_cmd_wait_prompt $sid1 "thread stop" {>\s*$}
log "Node1 thread stopped; waiting failover on Node2"

# Keep failover check lightweight to avoid long hangs on environments where
# Node2 remains router for extended periods.
send -i $sid2 -- "state\r"
expect -i $sid2 -re {leader|router}
set st $expect_out(0,string)
expect -i $sid2 -re {>\s*$}
if {$st eq "leader"} {
  log "Failover success: Node2 is leader"
} else {
  log "Failover note: Node2 is router; continuing"
}

# Cleanup after Exercise 1: factory reset nodes (keep sessions)
log "Cleanup: factoryreset Node1/Node2"
send_cmd_wait_prompt $sid2 "thread stop" {>\s*$}
send_cmd_wait_prompt $sid2 "factoryreset" {>\s*$}
send_cmd_wait_prompt $sid1 "factoryreset" {>\s*$}

# --- Exercise 2: Commissioning ---
log "Exercise 2: authenticate nodes with Commissioning (Commissioner=Node1, Joiner=Node2)"

# Re-create network on Node1
send_cmd_wait_prompt $sid1 "dataset init new" {>\s*$}
set network_key2 [capture_dataset_networkkey $sid1]
set pan_id2 [capture_dataset_panid $sid1]
send_cmd_wait_prompt $sid1 "dataset commit active" {>\s*$}
send_cmd_wait_prompt $sid1 "ifconfig up" {>\s*$}
send_cmd_wait_prompt $sid1 "thread start" {>\s*$}

verify_state_exact $sid1 "leader"
log "Node1 leader for commissioning"

start_commissioner_and_allow_wildcard $sid1

# Configure Node2 dataset with same key/panid then join as Joiner
send_cmd_wait_prompt $sid2 "dataset networkkey $network_key2" {>\s*$}
send_cmd_wait_prompt $sid2 "dataset panid 0x$pan_id2" {>\s*$}
send_cmd_wait_prompt $sid2 "ifconfig up" {>\s*$}
joiner_start_wait_success $sid2
send_cmd_wait_prompt $sid2 "thread start" {>\s*$}

set joined_ok 0
set joined_router 0
set start_time [clock seconds]
while {[expr {[clock seconds]-$start_time}] < 120} {
  send -i $sid2 -- "state\r"
  expect -i $sid2 -re {router|child}
  set st $expect_out(0,string)
  expect -i $sid2 -re {>\s*$}
  if {$st eq "router"} {
    set joined_ok 1
    set joined_router 1
    break
  }
  if {$st eq "child"} {
    set joined_ok 1
    break
  }
  after 3000
}
if {!$joined_ok} {
  fail "Node2 did not join network in Exercise 2 (router/child not reached)"
}
if {$joined_router} {
  log "Node2 joined and is router"
} else {
  log "Node2 joined and is child"
}

# Cleanup: reset nodes; exit Node2 CLI (we won't use it in Exercise 3)
log "Cleanup: factoryreset Node1/Node2 before ot-daemon exercise"
send_cmd_wait_prompt $sid2 "thread stop" {>\s*$}
send_cmd_wait_prompt $sid2 "factoryreset" {>\s*$}
send -i $sid2 -- "exit\r"
catch {expect -i $sid2 -re {eof} }

send_cmd_wait_prompt $sid1 "thread stop" {>\s*$}
send_cmd_wait_prompt $sid1 "factoryreset" {>\s*$}

# --- Exercise 3: ot-daemon + ot-ctl ---
log "Exercise 3: manage network with OpenThread Daemon (RCP) + ot-ctl"

# Start a new Thread network on Node1
send_cmd_wait_prompt $sid1 "dataset init new" {>\s*$}
set network_key3 [capture_dataset_networkkey $sid1]
set pan_id3 [capture_dataset_panid $sid1]
send_cmd_wait_prompt $sid1 "dataset commit active" {>\s*$}
send_cmd_wait_prompt $sid1 "ifconfig up" {>\s*$}
send_cmd_wait_prompt $sid1 "thread start" {>\s*$}
verify_state_exact $sid1 "leader"

set node1_eid3 [capture_ipaddr_eid $sid1]
log "Node1 EID for ping6: $node1_eid3"

set joiner_eui64 ""

# Ensure TUN exists
make_tun $container

# Start ot-daemon for RCP (Node2)
log "Spawning ot-daemon (RCP)"
set spinel_spec "spinel+hdlc+forkpty:///openthread/build/examples/apps/ncp/ot-rcp?forkpty-arg=2"
spawn docker exec -it $container bash -lc "/openthread/build/posix/src/posix/ot-daemon -v '$spinel_spec'"
set sid_daemon $spawn_id
# Wait a bit for daemon to create interface logs
expect -i $sid_daemon -re {Thread interface:|ot-daemon\[[0-9]+\]:}

# Start ot-ctl
log "Spawning ot-ctl (Terminal C)"
spawn docker exec -it $container bash -lc "/openthread/build/posix/src/posix/ot-ctl"
set sid_ctl $spawn_id
expect -i $sid_ctl -re {>\s*}

# Check ot-ctl initial state
send -i $sid_ctl -- "state\r"
expect -i $sid_ctl -re {disabled}
expect -i $sid_ctl -re {>\s*}

# Get eui64 for RCP and restrict join to it
send -i $sid_ctl -- "eui64\r"
set joiner_eui64 ""
expect -i $sid_ctl {
  -re {([0-9a-fA-F]{8,})\r?\n} {
    set joiner_eui64 $expect_out(1,string)
  }
  timeout {
    # Keep empty; we'll fallback below.
  }
}
catch {expect -i $sid_ctl -re {>\s*}}
if {$joiner_eui64 eq ""} {
  set joiner_eui64 "*"
  log "RCP eui64 not parsed; falling back to wildcard joiner admission"
} else {
  log "RCP eui64: $joiner_eui64"
}

# Start Commissioner role on Node1 (restricted to the RCP's EUI-64)
send_cmd_wait_prompt $sid1 "commissioner start" {>\s*$}
send_cmd_wait_prompt $sid1 "commissioner joiner add $joiner_eui64 J01NME" {>\s*$}

# Join via ot-ctl and start thread on RCP
send_cmd_wait_prompt $sid_ctl "ifconfig up" {>\s*}
log "ot-ctl joiner start ..."
send -i $sid_ctl -- "joiner start J01NME\r"
expect -i $sid_ctl -re {Join success}
expect -i $sid_ctl -re {>\s*}
send_cmd_wait_prompt $sid_ctl "thread start" {>\s*}

# Wait for router state on RCP
set rcp_state [wait_rcp_state $sid_ctl 120]
if {$rcp_state eq "router"} {
  log "RCP is router"
} elseif {$rcp_state eq "child"} {
  log "RCP is child; continuing"
} else {
  log "RCP still detached after joiner flow; applying explicit dataset fallback"
  send_cmd_wait_prompt $sid_ctl "dataset networkkey $network_key3" {>\s*}
  send_cmd_wait_prompt $sid_ctl "dataset panid 0x$pan_id3" {>\s*}
  send_cmd_wait_prompt $sid_ctl "dataset commit active" {>\s*}
  send_cmd_wait_prompt $sid_ctl "ifconfig up" {>\s*}
  send_cmd_wait_prompt $sid_ctl "thread start" {>\s*}
  set rcp_state [wait_rcp_state $sid_ctl 120]
  if {$rcp_state ne "router" && $rcp_state ne "child"} {
    fail "RCP did not attach to Thread network (state=$rcp_state)"
  }
  log "RCP attached after fallback (state=$rcp_state)"
}

# Exit ot-ctl
send -i $sid_ctl -- "exit\r"
catch {expect -i $sid_ctl -re {eof}}

# Validate connectivity using ping6 from container shell
log "Pinging Node1 EID from container shell (ping6)"
set ping_out [docker_exec_capture $container "ping6 -c 4 $node1_eid3 2>&1 || true"]
if {[regexp -nocase {(\d+)% packet loss} $ping_out -> loss]} {
  if {$loss == 0} {
    log "ping6 success: 0% packet loss"
  } elseif {$loss < 100} {
    log "ping6 partial success (${loss}% packet loss); verify output manually:"
    puts $ping_out
  } else {
    fail "ping6 failed (100% packet loss). Output:\n$ping_out"
  }
} else {
  fail "ping6 produced no packet-loss summary. Output:\n$ping_out"
}

# tcpdump verification (Exercise 3 last slide)
log "tcpdump verification (UDP 9001-9002)"
set tcpdump_path [docker_exec_capture $container "command -v tcpdump 2>/dev/null | tr -d '\\n' || true"]
if {$tcpdump_path eq ""} {
  log "tcpdump not found in container; skipping tcpdump verification"
} else {
  set tcpdump_out [docker_exec_capture $container [format {
    rm -f /tmp/tcpdump_lab.txt && \
    tcpdump -i any -n udp portrange 9001-9002 -c 30 > /tmp/tcpdump_lab.txt 2>&1 & \
    TPID=$!; \
    sleep 1; \
    ping6 -c 4 %s >/dev/null 2>&1 || true; \
    sleep 1; \
    kill $TPID >/dev/null 2>&1 || true; \
    cat /tmp/tcpdump_lab.txt || true
  } $node1_eid3]]

  # Basic heuristics: expect at least one tcpdump line or non-zero captured packets.
  if {[string length $tcpdump_out] < 30} {
    fail "tcpdump produced no useful output. Output:\n$tcpdump_out"
  }
  if {[string match -nocase *"0 packets captured"* $tcpdump_out]} {
    fail "tcpdump captured 0 packets while pinging"
  }
  log "tcpdump captured traffic (basic check passed)"
}

# Cleanup ot-daemon
log "Stopping ot-daemon"
send -i $sid_daemon -- "\003"
catch {wait }

log "AUTORUN COMPLETED SUCCESSFULLY"
exit 0

